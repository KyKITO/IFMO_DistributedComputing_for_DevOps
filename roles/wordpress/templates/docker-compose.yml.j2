services:
  wordpress:
    image: wordpress:php8.1
    container_name: wordpress
    restart: always
    expose:
      - 8080
    volumes:
      - "wp_data:/var/www/html/"
    environment:
      WORDPRESS_DB_HOST: db_master:3306
      WORDPRESS_DB_USER: {{ db_user }}
      WORDPRESS_DB_PASSWORD: {{ db_password }}
      WORDPRESS_DB_NAME: {{ db_name }}
    depends_on:
      - db_master
      - db_slave
    networks:
      - internal_network
      
  db_master:
    image: mysql:5.7
    container_name: {{mysql_master_name }}
    restart: always
    volumes:
      - "db_master:/var/lib/mysql"
      - "./mysql-master.cnf:/etc/mysql/conf.d/replication.cnf"
    ports:
      - 3306:3306
    environment:
      MYSQL_ROOT_PASSWORD: {{ db_root_pass }}
      MYSQL_DATABASE: {{ db_name }}
      MYSQL_USER: {{ db_user }}
      MYSQL_PASSWORD: {{ db_password }}
      MYSQL_REPLICATION_USER: {{ db_repl_user }}
      MYSQL_REPLICATION_PASSWORD: {{ db_repl_password }}
    networks:
      - internal_network

  db_slave:
    image: mysql:5.7
    container_name: {{ mysql_slave_name }}
    restart: always
    volumes:
      - "db_slave:/var/lib/mysql"
      - "./mysql-slave.cnf:/etc/mysql/conf.d/replication.cnf"
    ports:
      - 3307:3306
    environment:
      MYSQL_ROOT_PASSWORD: {{ db_root_pass }}
      MYSQL_REPLICATION_USER: {{ db_repl_user }}
      MYSQL_REPLICATION_PASSWORD: {{ db_repl_password }}
    depends_on:
      - db_master
    networks:
      - internal_network

  nginx:
    image: nginx:latest
    container_name: nginx
    restart: always
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf
      - wp_data:/var/www/html
    ports:
      - "80:80"
    depends_on:
      - wordpress
    networks:
      - internal_network

networks:
  internal_network:
    driver: bridge
    name: wordpress_internal_network

volumes:
  wp_data:
  db_master:
  db_slave:
