services:
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    restart: always
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml
    ports:
      - "9090:9090"
    networks:
      - internal_network

  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    restart: always
    volumes:
      - grafana_data:/var/lib/grafana
      - ./datasource.yml:/etc/grafana/provisioning/datasources/datasource.yml
      - ./dashboard.yml:/etc/grafana/provisioning/dashboards/dashboard.yml
      - ./mysql-dashboard.json:/etc/grafana/provisioning/dashboards/mysql-dashboard.json
    ports:
      - "3000:3000"
    networks:
      - internal_network

  mysql-exporter-master:
    image: prom/mysqld-exporter:latest
    container_name: {{ mysql_exp_master_name }}
    restart: always
    command: 
     - --config.my-cnf=/cfg/.my.cnf
     - --mysqld.address={{ mysql_master_name }}:3306
    volumes:
      - "./my.cnf:/cfg/.my.cnf"
    ports:
      - "9104:9104"
    networks:
      - internal_network

  mysql-exporter-slave:
    image: prom/mysqld-exporter:latest
    container_name: {{ mysql_exp_slave_name }}
    restart: always
    command: 
     - --config.my-cnf=/cfg/.my.cnf
     - --mysqld.address={{ mysql_slave_name }}:3306
    volumes:
      - "./my.cnf:/cfg/.my.cnf"
    ports:
      - "9105:9104"
    networks:
      - internal_network

networks:
  internal_network:
    external: true
    name: wordpress_internal_network

volumes:
  grafana_data: